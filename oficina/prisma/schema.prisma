// ==========================================================================
// Prisma Schema — Oficina Mecânica
// Banco: PostgreSQL (Neon em hospedagem, ou PostgreSQL no cluster Kubernetes)
// ==========================================================================

generator client {
  provider      = "prisma-client-js"
  // "native" = máquina de desenvolvimento; debian-openssl-3.0.x = imagem Docker (node:20-bookworm-slim)
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  // URL usada em runtime pela aplicação (no Neon: a URL "pooled", com -pooler).
  url       = env("DATABASE_URL")
  // URL direta, usada só para db push/migrate. No cluster local é igual à DATABASE_URL.
  directUrl = env("DIRECT_URL")
}

enum StatusOrdem {
  ABERTA
  EM_ANDAMENTO
  AGUARDANDO_PECA
  FINALIZADA
  CANCELADA
}

enum Role {
  MASTER // acesso total + gestão de usuários (uso da manutenção/dono do sistema)
  PADRAO // acesso operacional ao sistema (uso do dia a dia da oficina)
}

model Usuario {
  id        String   @id @default(cuid())
  nome      String
  email     String   @unique
  senhaHash String
  role      Role     @default(PADRAO)
  ativo     Boolean  @default(true)
  createdAt DateTime @default(now())
}

// Linha única (singleton) com os dados da oficina, usados no cabeçalho dos
// PDFs de orçamento. O id é sempre "default".
model ConfiguracaoOficina {
  id        String  @id @default("default")
  nome      String  @default("Minha Oficina")
  endereco  String?
  telefone  String?
  email     String?
  validadeOrcamentoDias Int @default(7)
}

model Cliente {
  id        String   @id @default(cuid())
  nome      String
  telefone  String
  email     String?
  cpfCnpj   String?  @unique
  endereco  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  veiculos Veiculo[]
  ordens   OrdemServico[]

  @@index([nome])
}

model Veiculo {
  id        String   @id @default(cuid())
  placa     String   @unique
  marca     String
  modelo    String
  ano       Int?
  cor       String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  clienteId String
  cliente   Cliente @relation(fields: [clienteId], references: [id], onDelete: Cascade)

  ordens OrdemServico[]

  @@index([clienteId])
}

model Funcionario {
  id        String   @id @default(cuid())
  nome      String
  cargo     String
  telefone  String?
  ativo     Boolean  @default(true)
  createdAt DateTime @default(now())

  ordens OrdemServico[]
}

model Peca {
  id               String   @id @default(cuid())
  codigo           String   @unique
  nome             String
  quantidade       Int      @default(0)
  quantidadeMinima Int      @default(1)
  precoCusto       Decimal  @default(0) @db.Decimal(10, 2)
  precoVenda       Decimal  @default(0) @db.Decimal(10, 2)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  itens ItemOrdemServico[]

  @@index([nome])
}

model OrdemServico {
  id                String      @id @default(cuid())
  numero            Int         @unique @default(autoincrement())
  status            StatusOrdem @default(ABERTA)
  descricaoProblema String
  observacoes       String?
  dataAbertura      DateTime    @default(now())
  dataFechamento    DateTime?
  valorTotal        Decimal     @default(0) @db.Decimal(10, 2)

  clienteId String
  cliente   Cliente @relation(fields: [clienteId], references: [id])

  veiculoId String
  veiculo   Veiculo @relation(fields: [veiculoId], references: [id])

  funcionarioId String?
  funcionario   Funcionario? @relation(fields: [funcionarioId], references: [id])

  itens ItemOrdemServico[]

  @@index([status])
  @@index([veiculoId])
  @@index([clienteId])
}

model ItemOrdemServico {
  id            String  @id @default(cuid())
  descricao     String
  quantidade    Int     @default(1)
  valorUnitario Decimal @db.Decimal(10, 2)

  ordemId String
  ordem   OrdemServico @relation(fields: [ordemId], references: [id], onDelete: Cascade)

  pecaId String?
  peca   Peca?   @relation(fields: [pecaId], references: [id])
}
